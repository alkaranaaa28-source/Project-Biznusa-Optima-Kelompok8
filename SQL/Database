
-- ============================================
-- DATABASE BIZNUSA OPTIMA
-- ============================================

CREATE DATABASE IF NOT EXISTS db_biznusa;
USE db_biznusa;

-- ============================================
-- 1. TABEL OWNER UMKM
-- ============================================

CREATE TABLE owner_umkm (
    id_owner VARCHAR(10) PRIMARY KEY,
    nama_owner VARCHAR(100) NOT NULL
);

-- ============================================
-- 2. TABEL STAF UMKM
-- ============================================

CREATE TABLE staf_umkm (
    id_staf VARCHAR(10) PRIMARY KEY,
    nama_staf VARCHAR(100) NOT NULL,
    id_owner VARCHAR(10),
    FOREIGN KEY (id_owner)
        REFERENCES owner_umkm(id_owner)
);

-- ============================================
-- 3. TABEL ABSENSI
-- ============================================

CREATE TABLE absensi (
    id_absensi VARCHAR(10) PRIMARY KEY,
    tanggal DATE NOT NULL,
    id_staf VARCHAR(10),
    FOREIGN KEY (id_staf)
        REFERENCES staf_umkm(id_staf)
);

-- ============================================
-- 4. TABEL ADUAN PELANGGAN
-- ============================================

CREATE TABLE aduan_pelanggan (
    id_aduan VARCHAR(10) PRIMARY KEY,
    status_aduan VARCHAR(50) NOT NULL,
    id_absensi VARCHAR(10),
    FOREIGN KEY (id_absensi)
        REFERENCES absensi(id_absensi)
);

-- ============================================
-- 5. TABEL STOK GUDANG
-- ============================================

CREATE TABLE stok_gudang (
    id_stok VARCHAR(10) PRIMARY KEY,
    jumlah_stok INT NOT NULL,
    id_owner VARCHAR(10),
    FOREIGN KEY (id_owner)
        REFERENCES owner_umkm(id_owner)
);

-- ============================================
-- 6. TABEL TRANSAKSI
-- ============================================

CREATE TABLE transaksi (
    id_transaksi VARCHAR(10) PRIMARY KEY,
    total_transaksi DECIMAL(15,2) NOT NULL,
    id_staf VARCHAR(10),
    FOREIGN KEY (id_staf)
        REFERENCES staf_umkm(id_staf)
);

-- ============================================
-- 7. TABEL PEMBAYARAN
-- ============================================

CREATE TABLE pembayaran (
    id_pembayaran VARCHAR(10) PRIMARY KEY,
    status_pembayaran VARCHAR(50) NOT NULL,
    id_transaksi VARCHAR(10),
    FOREIGN KEY (id_transaksi)
        REFERENCES transaksi(id_transaksi)
);

